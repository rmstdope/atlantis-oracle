{
  "name": "atlantis-oracle",
  "version": "0.1.0",
  "description": "Discord bot that answers Atlantis PBEM questions from the game's source code",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "register-commands": "tsx src/discord/register.ts",
    "ask": "tsx src/cli.ts",
    "eval": "tsx src/evals/run.ts",
    "eval:topic": "tsx src/evals/topic.ts",
    "guide:check": "tsx src/guide/check.ts"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.4",
    "node-html-markdown": "^2.0.0",
    "openai": "^7.25.0",
    "pino": "^10.3.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
