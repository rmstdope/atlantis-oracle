{
  "services": {
    "worker": {
      "image": "${WORKER_IMAGE:?Set an immutable image reference}",
      "restart": "unless-stopped",
      "init": true,
      "env_file": ["${SECRETS_DIR}/bot.env"],
      "volumes": [{ "type": "volume", "source": "data", "target": "/app/data" }],
      "healthcheck": {
        "test": ["CMD", "node", "dist/health.js"],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "1200s"
      },
      "logging": {
        "driver": "json-file",
        "options": { "max-size": "10m", "max-file": "3" }
      },
      "mem_limit": "2g"
    }
  },
  "volumes": {
    "data": { "name": "rmstdope-atlantis-oracle-data" }
  }
}
