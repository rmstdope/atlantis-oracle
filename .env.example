# --- Discord (required for the bot; not needed for `npm run ask`) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Register slash commands to a single server (instant updates, good for development)
DISCORD_GUILD_ID=
# Push the slash commands to Discord at every start (instead of `npm run register-commands`)
DISCORD_REGISTER_COMMANDS=false
# Comma-separated channel IDs where the bot answers; empty = all channels
ALLOWED_CHANNEL_IDS=
# Comma-separated slash commands to offer: ask, collective-info, report-bug,
# wish, anomalies, latest-release. Empty = all (report-bug and wish only when GITHUB_TOKEN is
# set; anomalies also needs tracking, see below). Disabling ask also
# disables follow-ups in answer threads. Run `npm run register-commands` after a change.
ENABLED_COMMANDS=

# --- LLM (any OpenAI-compatible endpoint with tool calling) ---
# Examples: https://api.openai.com/v1, http://localhost:11434/v1 (Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1
# Local servers usually accept any non-empty value
OPENAI_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
# Nucleus sampling; leave empty for the server default (Qwen3: 0.95 with temperature 0.6)
LLM_TOP_P=
LLM_MAX_TOOL_ITERATIONS=16
LLM_REQUEST_TIMEOUT_SECONDS=120
# Retries per request, timeouts included; 0 is best for local servers
LLM_MAX_RETRIES=2
# Output cap per request (max_tokens); stops runaway generations
LLM_MAX_TOKENS=4096
# Reasoning for thinking models: on (server default), off, or final (only for the
# final answer and review). off/final send chat_template_kwargs.enable_thinking.
LLM_THINKING=on
LLM_FINAL_MAX_TOKENS=8192
# Total characters of tool output per question
LLM_TOOL_OUTPUT_BUDGET=60000
# Concurrent LLM requests; keep at 1 for most local servers
LLM_MAX_CONCURRENT=1
# Ask for a research plan first, and review the draft answer against the
# research before sending it (slower, better answers)
LLM_PLAN_STEP=true
LLM_REVIEW_STEP=true
# Turn away messages that are not about Atlantis before researching them (one short
# LLM call per message; on doubt or failure the question is answered)
LLM_TOPIC_CHECK=true
# How the model finds its way around the code: grep (search_code) or guide
# (a hand-written map from game topics to the deciding functions, see CODE_GUIDE_PATH)
LLM_LOOKUP_MODE=grep

# --- Game repository ---
GAME_REPO_URL=https://github.com/Atlantis-PBEM/Atlantis.git
GAME_REPO_BRANCH=
GAME_REPO_DIR=./data/game-repo
# 0 disables periodic sync
GAME_REPO_SYNC_INTERVAL_MINUTES=360
DEFAULT_GAME_VARIANT=standard

# --- Player rules ---
# Built rules (HTML, Markdown) and the build workspace
RULES_DIR=./data/rules
# Build the rules with the game's Makefile (needs make and a C++20 compiler).
# false = use the committed snapshot-tests/rules/*.html only.
RULES_BUILD=true

# --- Code guide (LLM_LOOKUP_MODE=guide) ---
# Markdown map from game topics to functions and tables; symbols are resolved
# to path:line against the current commit. Missing file = grep lookup.
CODE_GUIDE_PATH=./guides/atlantis-code.md

# --- Bug reports and wishes (/report-bug, /wish, /anomalies) ---
# Token of the GitHub account that files the issues: a fine-grained token with
# "Issues: Read and write" on GITHUB_ISSUES_REPO. Empty = these commands are off.
GITHUB_TOKEN=
# The HUD repository: receives the issues; /latest-release shows its releases
GITHUB_ISSUES_REPO=rmstdope/atlantis-hud
# Linked from /latest-release
HUD_SITE_URL=https://atlantis-hud.rmstdope.eu
# Channel ID where new HUD releases are announced (same message as
# /latest-release); empty = no announcements. The first run announces the
# current release. Later edits of the release notes update the announcement.
# Works without GITHUB_TOKEN.
RELEASE_ANNOUNCE_CHANNEL_ID=
# How often to look for a new release; 0 = never
RELEASE_POLL_INTERVAL_MINUTES=15
# Remembers the last announced release across restarts
RELEASE_STATE_PATH=./data/latest-release.json
# Comma-separated labels for new issues (they must exist in the repo),
# e.g. bug and enhancement
GITHUB_BUG_LABELS=
GITHUB_WISH_LABELS=
# Bug reports and wishes together, per user
BUG_REPORTS_PER_USER_PER_HOUR=3
# Follow filed issues and post new comments in a thread on the report.
# 0 = don't track.
GITHUB_POLL_INTERVAL_MINUTES=15
# Days a closed issue is still followed, in case it is reopened
GITHUB_TRACK_CLOSED_DAYS=14
ANOMALY_STORE_PATH=./data/anomalies.json

# --- Misc ---
RATE_LIMIT_PER_USER_PER_MINUTE=3
LOG_LEVEL=info
